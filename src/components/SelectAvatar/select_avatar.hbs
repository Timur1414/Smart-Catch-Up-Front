<div class="select_avatar_overlay">
    <div class="select_avatar_window">
        <button class="select_avatar_window_close_btn" type="button" aria-label="Закрыть">&times;</button>
        <div class="select_avatar_header">
            <p>Текущий аватар</p>
            <img class="select_avatar_img" src="{{url}}" alt="{{url}}">
        </div>
        <div class="select_avatar_content">
            <input class="select_avatar_input" type="file" accept="image/png,image/jpeg,image/bmp,image/webp">
            <p class="select_avatar_error"></p>
            <button class="select_avatar_save_btn">Сохранить</button>
        </div>
    </div>
</div>