<div class="notification_container">
    <div class="notification">
        <img class="notification_img" src="{{img}}" alt="{{img}}">
        <div class="notification_content">
            <div class="notification_header">
                <div class="notification_actor">{{actor}}</div>
                <div class="notification_date">{{date}}</div>
            </div>
            <div class="notification_payload">{{payload}}</div>
            <div class="notification_actions">
                {{#each actions}}
                    {{#if (equal action_type "click")}}
                        <button class="notification_content_action_btn">{{action_target}}</button>
                    {{else}}
                        <p class="notification_content_action_text">{{action_target}}</p>
                    {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
</div>