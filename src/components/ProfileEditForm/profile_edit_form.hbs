<form class="profile_edit_form">
    <div class="profile_edit_grid">
        <label for="email" class="profile_edit_label">Почта</label>
        <input id="email" class="profile_edit_input" type="email" name="email" value="{{email}}" placeholder="Почта">
        <label for="first_name" class="profile_edit_label">Имя</label>
        <input id="first_name" class="profile_edit_input" type="text" name="first_name" value="{{first_name}}" placeholder="Имя">
        <label for="last_name" class="profile_edit_label">Фамилия</label>
        <input id="last_name" class="profile_edit_input" type="text" name="last_name" value="{{last_name}}" placeholder="Фамилия">
    </div>
    <input class="profile_edit_send_btn" type="submit" value="Сохранить">
</form>