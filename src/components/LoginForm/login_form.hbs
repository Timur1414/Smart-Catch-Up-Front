<div class="login_content">
    <h1 class="login_header">Вход</h1>
    <form class="login-form" action="/" method="post">
        <label class="login_label"> Почта
            <input id="login-form_email_input" class="login_input" type="email" name="email" placeholder="email">
        </label>
        <p class="login-form_error"></p>
        <label class="login_label"> Пароль
            <input id="login-form_password_input" class="login_input" type="password" name="password" placeholder="password">
            <img class="login-form_eye" src="/icons/eye.png" alt="eye">
        </label>
        <p class="login-form_error"></p>
        <div class="login-form_forgot_password">
            <a class="login-form_forgot_password_link" href="#">Забыли пароль?</a>
        </div>
        <div class="login-form_register_block">
            <span>Ещё нет аккаунта?</span>
            <a class="login-form_register_link" href="/register">Зарегистрировать</a>
        </div>
        <input class="login_btn" type="submit" value="Войти">
    </form>
</div>