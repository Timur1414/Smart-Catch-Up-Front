{
  "manifest_version": 3,
  "name": "VK Smart Catch-Up",
  "version": "1.0.0",
  "description": "VK Smart Catch-Up",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VK Smart Catch-Up",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://vk.ru/*",
    "https://*.vk.ru/*",
    "http://localhost:8081/*",
    "https://my.domain.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "styles/*"
      ],
      "matches": [
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ]
    }
  ]
}
